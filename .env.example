# Copy to .env for local runs (outside Docker). Real environment variables
# take precedence over this file.

# Postgres/Redis running locally or via `docker compose up -d postgres redis`
DATABASE_URL=postgresql+psycopg://support_user:support_pass@localhost:5432/support_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ENVIRONMENT=development
LOG_FORMAT=text

# Every ticket endpoint requires X-API-Key matching one of these (comma-separated).
# Each entry is "key" (read-write) or "name:key:scope" with scope read or write,
# e.g. API_KEYS=ops:<random>:write,viewer:<random>:read
API_KEYS=

# LLM backend: auto | openai | anthropic | fake
# auto uses OpenAI if OPENAI_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY
# is set, else the offline fake provider (not allowed when ENVIRONMENT=production).
LLM_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# How long an Idempotency-Key on POST /tickets is remembered (seconds, default 24 h).
IDEMPOTENCY_KEY_TTL_SECONDS=86400
